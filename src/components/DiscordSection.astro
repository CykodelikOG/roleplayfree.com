---
import content from '../content/site-content.json';
const { discordServers } = content;
---

<section class="section section--alt" id="discord">
  <div class="container">
    <h2 class="section__heading">Discord</h2>

    <div style="margin-bottom: var(--space-lg); text-align: center;">
      <h3 style="margin-bottom: var(--space-sm);">Roleplayfree's Discord</h3>
      <iframe
        src="https://discord.com/widget?id=1504064773619323051&theme=dark"
        width="100%"
        height="400"
        allowtransparency="true"
        frameborder="0"
        sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
        style="border-radius: var(--radius-lg); display: block; max-width: 700px; margin: 0 auto;"
      ></iframe>
    </div>

    <h3 style="margin-bottom: var(--space-md);">Community servers by system</h3>
    <div class="discord-servers">
      {discordServers.map(server => (
        <div class="discord-card">
          <span class="discord-card__system">{server.system}</span>
          {server.href && (
            <a href={server.href} target="_blank" rel="noopener" class="discord-card__name">{server.name} ↗</a>
          )}
          {server.description && (
            <span class="discord-card__desc">{server.description}</span>
          )}
          {server.searchHref && (
            <a href={server.searchHref} target="_blank" rel="noopener" class="discord-card__search">
              Find more {server.system} servers ↗
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
