---
/**
 * PlayNow.astro -- top-of-homepage block for people who do not want to research.
 *
 * Why it exists: GA4 says 77% of visitors bounce and the average visit is 18
 * seconds, with every session landing on `/` and never reaching a second page.
 * The page was asking a newcomer to read eleven system cards and choose. This
 * gives them one honest action instead.
 *
 * All copy and links live in site-content.json under `playNow`, per the project
 * file-structure rule. To change wording or reorder the options, edit that file
 * and not this component.
 *
 * Every option states what you get AND what the catch is, at equal visual
 * weight, because the whole point is that nobody arrives at a turn limit or a
 * paywall by surprise.
 *
 * Tracking: the section carries id="play-now", so the delegated listener in
 * Analytics.astro reports these clicks as outbound_click / affiliate_click with
 * section="play-now". No per-link tracking code needed here.
 */
import content from '../content/site-content.json';

const block = (content as any).playNow;

function toneClass(tone: string) {
  if (tone === 'warn') return 'pn-badge--warn';
  if (tone === 'reg') return 'pn-badge--reg';
  return 'pn-badge--free';
}
---

<section class="pn" id="play-now" aria-labelledby="play-now-heading">
  <div class="container">
    <h2 class="pn-heading" id="play-now-heading">{block.heading}</h2>
    <p class="pn-intro">{block.intro}</p>

    <div class="pn-options">
      {block.options.map((opt: any) => (
        <article class="pn-opt" style={`--pn-stripe: ${opt.accent}`}>
          <div class="pn-opt__head">
            <span class="pn-opt__icon" aria-hidden="true">
              {opt.icon === 'people' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="8" r="3"></circle>
                  <path d="M3.5 20a5.5 5.5 0 0 1 11 0"></path>
                  <circle cx="17" cy="9.5" r="2.4"></circle>
                  <path d="M16 15.2a4.6 4.6 0 0 1 4.5 4.8"></path>
                </svg>
              )}
              {opt.icon === 'chat' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8c-1.4 2.9-4.6 4.7-8.1 4.7a9.6 9.6 0 0 1-2.6-.4L5 21l1.4-4.2A8.2 8.2 0 0 1 4 11.5C4 7.1 7.9 3.5 12.5 3.5S21 7.1 21 11.5Z"></path>
                  <path d="M9 11h.01M12.5 11h.01M16 11h.01"></path>
                </svg>
              )}
              {opt.icon === 'terminal' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                  <path d="M7 9l2.5 2.5L7 14"></path>
                  <path d="M12.5 15h4.5"></path>
                </svg>
              )}
            </span>
            <div>
              <h3 class="pn-opt__name">{opt.name}</h3>
              <p class="pn-opt__what">{opt.what}</p>
            </div>
          </div>

          <div class="pn-badges">
            {opt.badges.map((b: any) => (
              <span class={`pn-badge ${toneClass(b.tone)}`}>{b.text}</span>
            ))}
          </div>

          <div class="pn-cols">
            <div class="pn-col pn-col--get">
              <h4>What you get</h4>
              <ul>
                {opt.get.map((g: string) => <li>{g}</li>)}
              </ul>
            </div>
            <div class="pn-col pn-col--catch">
              <h4>The catch</h4>
              <ul>
                {opt.catch.map((c: string) => <li>{c}</li>)}
              </ul>
            </div>
          </div>

          {opt.note && <p class="pn-note">{opt.note}</p>}

          <a class="pn-cta" href={opt.href} target="_blank" rel="noopener">
            <span class="pn-cta__main">Play now for free<span class="pn-cta__arrow" aria-hidden="true">&rarr;</span></span>
            <span class="pn-cta__sub">{opt.ctaSub}</span>
          </a>
        </article>
      ))}
    </div>

    <p class="pn-footnote">{block.footnote}</p>
  </div>
</section>

<style>
  .pn {
    padding-block: var(--space-lg) var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .pn-heading {
    font-size: clamp(1.5rem, 5vw, 2rem);
    line-height: 1.2;
    margin: 0 0 var(--space-xs);
    text-wrap: balance;
  }

  .pn-intro {
    margin: 0 0 var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-border);
    max-width: 62ch;
  }

  .pn-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .pn-opt {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--pn-stripe);
    border-radius: var(--radius);
    padding: var(--space-sm);
  }

  .pn-opt__head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .pn-opt__icon {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    margin-top: 2px;
    color: var(--pn-stripe);
  }
  .pn-opt__icon svg { display: block; width: 100%; height: 100%; }

  .pn-opt__name {
    font-size: 1.25rem;
    margin: 0;
    line-height: 1.25;
  }

  .pn-opt__what {
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .pn-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0 1rem;
  }

  .pn-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
  }
  .pn-badge--free { background: #D1FAE5; color: #065F46; }
  .pn-badge--reg  { background: #E0F2FE; color: #0369A1; }
  .pn-badge--warn { background: #FEF3C7; color: #92400E; }

  .pn-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.5rem;
  }

  .pn-col h4 {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin: 0 0 0.45rem;
    color: var(--color-text-muted);
  }

  .pn-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  .pn-col li {
    padding-left: 1rem;
    position: relative;
  }
  .pn-col li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
  }
  .pn-col--get li::before { content: "+"; color: #4A7C59; }
  .pn-col--catch li::before { content: "\2212"; color: #8A6A3D; }

  .pn-note {
    margin: 1rem 0 0;
    padding: 0.7rem 0.85rem;
    background: #FEF3C7;
    color: #92400E;
    border-radius: 4px;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Forest green and gold are both existing system card accents, so the
     button is loud without introducing a colour the site has never used. */
  .pn-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    width: 100%;
    box-sizing: border-box;
    margin-top: 1.25rem;
    padding: 0.85rem 1.25rem;
    background: #2D5016;
    border: 2px solid #C9A84C;
    border-radius: var(--radius);
    color: #FBF7EC;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 2px 0 0 rgba(44, 44, 44, 0.18);
    transition: background-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
  }

  .pn-cta__main {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }

  .pn-cta__arrow {
    font-size: 0.95em;
    padding-left: 0.3rem;
  }

  .pn-cta__sub {
    font-size: 0.8rem;
    font-weight: 500;
    color: #E3D3A2;
    line-height: 1.3;
  }

  .pn-cta:hover {
    background: #3A6A1E;
    transform: translateY(-1px);
    box-shadow: 0 4px 0 0 rgba(44, 44, 44, 0.2);
  }

  .pn-cta:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 0 rgba(44, 44, 44, 0.18);
  }

  .pn-cta:focus-visible {
    outline: 3px solid #C9A84C;
    outline-offset: 3px;
  }

  .pn-footnote {
    margin: var(--space-md) 0 0;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .pn-cols { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pn-cta { transition: none; }
    .pn-cta:hover, .pn-cta:active { transform: none; }
  }
</style>
