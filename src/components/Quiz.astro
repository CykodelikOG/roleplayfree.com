---
import content from '../content/site-content.json';
const { quiz, systems } = content;

const systemMap = Object.fromEntries(systems.map(s => [s.id, s]));
const quizJson = JSON.stringify({ questions: quiz.questions, systemMap });
---

<section class="quiz-section" id="quiz">
  <div class="container">

    <div class="quiz-header">
      <h2>{quiz.title}</h2>
      <p class="quiz-header__subtitle">{quiz.subtitle}</p>
    </div>

    <!-- Share SET 1: pre-quiz -->
    <div class="quiz-share--pre" id="quiz-share-pre">
      <p class="quiz-share__text">{quiz.sharePreText}</p>
      <div class="share-buttons">
        <button class="share-btn" data-share="facebook" data-pre="true">Facebook</button>
        <button class="share-btn" data-share="twitter" data-pre="true">X / Twitter</button>
        <button class="share-btn" data-share="whatsapp" data-pre="true">WhatsApp</button>
        <button class="share-btn" data-share="copy" data-pre="true" id="copy-btn-pre">Copy link</button>
      </div>
    </div>

    <!-- Friend prompt (shown when ?result= param present) -->
    <div class="quiz-friend-prompt" id="quiz-friend-prompt" style="display:none"></div>

    <!-- Quiz box -->
    <div class="quiz-box" id="quiz-box">

      <!-- Progress bar -->
      <div class="quiz-progress" id="quiz-progress" style="display:none">
        <div class="quiz-progress__bar-track">
          <div class="quiz-progress__bar" id="progress-bar" style="width: 12.5%"></div>
        </div>
        <div class="quiz-progress__label" id="progress-label">Question 1 of 8</div>
      </div>

      <!-- Questions (rendered server-side, shown/hidden by JS) -->
      {quiz.questions.map((q, i) => (
        <div class="quiz-question" id={`question-${i}`} style={i === 0 ? '' : 'display:none'}>
          <p class="quiz-question__text">{q.text}</p>
          {q.type === 'multi' && <p class="quiz-question__hint">{(q as any).hint}</p>}
          <div class="quiz-options" data-type={q.type}>
            {q.options.map(opt => (
              <button class="quiz-option" data-value={opt.id} data-qindex={i}>
                {opt.text}
              </button>
            ))}
          </div>
          {q.type === 'multi' && (
            <button class="quiz-next-btn" id={`next-btn-${i}`} disabled>Next →</button>
          )}
        </div>
      ))}

      <!-- Result (hidden until quiz complete) -->
      <div id="quiz-result" style="display:none">
        <h3 class="quiz-result__heading" id="result-heading">Your result</h3>
        <div class="result-cards">
          <div class="result-card result-card--primary">
            <div class="result-card__label">Your game is</div>
            <div class="result-card__name" id="result-primary-name"></div>
            <p class="result-card__why" id="result-primary-why"></p>
            <a href="#systems" class="btn btn--primary" id="result-primary-link">See this system ↓</a>
          </div>
          <div class="result-card">
            <div class="result-card__label">Your runner-up is</div>
            <div class="result-card__name" id="result-secondary-name"></div>
            <p class="result-card__runner-up-note" id="result-runner-up-note"></p>
            <p class="result-card__why" id="result-secondary-why"></p>
            <a href="#systems" class="btn btn--secondary" id="result-secondary-link">See this system ↓</a>
          </div>
        </div>

        <!-- Share SET 2: post-result -->
        <div style="margin-top: var(--space-md)">
          <p class="quiz-share__text">Share your result with your group:</p>
          <div class="share-buttons" id="share-buttons-post">
            <button class="share-btn" data-share="facebook" data-pre="false">Facebook</button>
            <button class="share-btn" data-share="twitter" data-pre="false">X / Twitter</button>
            <button class="share-btn" data-share="whatsapp" data-pre="false">WhatsApp</button>
            <button class="share-btn" data-share="copy" data-pre="false" id="copy-btn-post">Copy link</button>
          </div>
        </div>

        <div class="quiz-retake">
          <button class="btn btn--ghost" id="retake-btn">Retake the quiz</button>
        </div>
      </div>

    </div>
  </div>
</section>

<script define:vars={{ quizJson }}>
  const { questions, systemMap } = JSON.parse(quizJson);

  const TOTAL = questions.length;
  const STORAGE_KEY = 'rfree_quiz_v1';

  // State
  let currentQ = 0;
  let answers = new Array(TOTAL).fill(null);
  let primaryResult = null;
  let secondaryResult = null;
  let primaryName = '';

  // DOM refs
  const progressBar = document.getElementById('progress-bar');
  const progressLabel = document.getElementById('progress-label');
  const progressEl = document.getElementById('quiz-progress');
  const resultEl = document.getElementById('quiz-result');
  const friendPrompt = document.getElementById('quiz-friend-prompt');

  // ── Persistence ──────────────────────────────────────
  function saveState() {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
        currentQ, answers, primaryResult, secondaryResult, primaryName
      }));
    } catch (_) {}
  }

  function clearState() {
    try { sessionStorage.removeItem(STORAGE_KEY); } catch (_) {}
  }

  function loadState() {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const s = JSON.parse(raw);
      currentQ      = s.currentQ      ?? 0;
      answers       = s.answers       ?? new Array(TOTAL).fill(null);
      primaryResult = s.primaryResult ?? null;
      secondaryResult = s.secondaryResult ?? null;
      primaryName   = s.primaryName   ?? '';
      return true;
    } catch (_) {
      return false;
    }
  }

  // ── Display ───────────────────────────────────────────
  function showQuestion(index) {
    for (let i = 0; i < TOTAL; i++) {
      const el = document.getElementById(`question-${i}`);
      if (el) el.style.display = i === index ? '' : 'none';
    }
    if (resultEl) resultEl.style.display = 'none';
    if (progressEl) progressEl.style.display = '';
    const pct = ((index + 1) / TOTAL) * 100;
    if (progressBar) progressBar.style.width = `${pct}%`;
    if (progressLabel) progressLabel.textContent = `Question ${index + 1} of ${TOTAL}`;
  }

  function restoreMultiSelectVisuals() {
    answers.forEach((answer, i) => {
      if (!Array.isArray(answer)) return;
      answer.forEach(val => {
        const btn = document.querySelector(`.quiz-option[data-qindex="${i}"][data-value="${val}"]`);
        btn?.classList.add('selected');
      });
      const nextBtn = document.getElementById(`next-btn-${i}`);
      if (nextBtn) nextBtn.disabled = answer.length === 0;
    });
  }

  function showResult(primaryId, secondaryId) {
    const primary = systemMap[primaryId];
    const secondary = systemMap[secondaryId];

    document.getElementById('result-primary-name').textContent = primary?.name ?? primaryId;
    document.getElementById('result-primary-why').textContent = primary?.quizResultWhy ?? '';
    const primaryLink = document.getElementById('result-primary-link');
    if (primaryLink) primaryLink.href = `#system-${primaryId}`;

    document.getElementById('result-secondary-name').textContent = secondary?.name ?? secondaryId;
    document.getElementById('result-runner-up-note').textContent =
      `Not feeling ${primary?.name ?? primaryId}? This one fits you almost as well, for different reasons.`;
    document.getElementById('result-secondary-why').textContent = secondary?.quizResultWhy ?? '';
    const secondaryLink = document.getElementById('result-secondary-link');
    if (secondaryLink) secondaryLink.href = `#system-${secondaryId}`;

    for (let i = 0; i < TOTAL; i++) {
      const el = document.getElementById(`question-${i}`);
      if (el) el.style.display = 'none';
    }
    if (progressEl) progressEl.style.display = 'none';
    if (resultEl) resultEl.style.display = '';

    primaryResult = primaryId;
    secondaryResult = secondaryId;
    primaryName = primary?.name ?? primaryId;

    const url = new URL(window.location.href);
    url.searchParams.set('result', primaryId);
    window.history.replaceState({}, '', url.toString());

    saveState();
  }

  // ── Scoring ───────────────────────────────────────────
  function calculateScores() {
    const scores = {};
    Object.keys(systemMap).forEach(id => { scores[id] = 0; });

    answers.forEach((answer, i) => {
      if (answer === null) return;
      const q = questions[i];
      const selected = Array.isArray(answer) ? answer : [answer];
      selected.forEach(sel => {
        const opt = q.options.find(o => o.id === sel);
        if (!opt) return;
        Object.entries(opt.weights).forEach(([sys, pts]) => {
          scores[sys] = (scores[sys] || 0) + Number(pts);
        });
      });
    });

    return Object.entries(scores)
      .sort((a, b) => b[1] - a[1])
      .filter(([, pts]) => pts > 0)
      .map(([id]) => id);
  }

  function advanceTo(index) {
    if (index >= TOTAL) {
      const ranked = calculateScores();
      showResult(ranked[0] ?? 'dnd', ranked[1] ?? 'vampire');
    } else {
      currentQ = index;
      showQuestion(index);
      saveState();
    }
  }

  // ── Event listeners ───────────────────────────────────
  document.querySelectorAll('.quiz-option').forEach(btn => {
    btn.addEventListener('click', () => {
      const qIndex = parseInt(btn.dataset.qindex);
      const type = btn.closest('.quiz-options')?.dataset.type;
      const value = btn.dataset.value;

      if (type === 'single') {
        answers[qIndex] = value;
        advanceTo(qIndex + 1);
      } else if (type === 'multi') {
        const current = answers[qIndex] ?? [];
        const updated = [...current];
        const idx = updated.indexOf(value);
        if (idx === -1) {
          if (updated.length < 4) {
            updated.push(value);
            btn.classList.add('selected');
          }
        } else {
          updated.splice(idx, 1);
          btn.classList.remove('selected');
        }
        answers[qIndex] = updated;
        const nextBtn = document.getElementById(`next-btn-${qIndex}`);
        if (nextBtn) nextBtn.disabled = updated.length === 0;
        saveState();
      }
    });
  });

  document.querySelectorAll('.quiz-next-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const i = parseInt(btn.id.replace('next-btn-', ''));
      advanceTo(i + 1);
    });
  });

  document.getElementById('retake-btn')?.addEventListener('click', () => {
    currentQ = 0;
    answers = new Array(TOTAL).fill(null);
    primaryResult = null;
    secondaryResult = null;
    primaryName = '';
    clearState();

    document.querySelectorAll('.quiz-option').forEach(b => b.classList.remove('selected'));
    document.querySelectorAll('.quiz-next-btn').forEach(b => { b.disabled = true; });
    if (resultEl) resultEl.style.display = 'none';
    showQuestion(0);

    const url = new URL(window.location.href);
    url.searchParams.delete('result');
    window.history.replaceState({}, '', url.toString());
  });

  // ── Share ─────────────────────────────────────────────
  const PRE_TEXT = 'Not sure what RPG to play? Take this quiz and find your system. Share it with your group so everyone finds theirs.';
  const QUIZ_URL = window.location.origin + '/quiz';

  function getShareUrl(isPre) {
    if (isPre || !primaryResult) return QUIZ_URL;
    const u = new URL(QUIZ_URL);
    u.searchParams.set('result', primaryResult);
    return u.toString();
  }

  function getShareText(isPre) {
    if (isPre || !primaryName) return PRE_TEXT;
    return `I got ${primaryName}. What tabletop RPG are you? Find out:`;
  }

  document.querySelectorAll('.share-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const platform = btn.dataset.share;
      const isPre = btn.dataset.pre === 'true';
      const url = getShareUrl(isPre);
      const text = getShareText(isPre);

      if (platform === 'copy') {
        navigator.clipboard.writeText(url).then(() => {
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = orig; }, 2000);
        });
        return;
      }

      const shareUrls = {
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
        twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`,
        whatsapp: `https://wa.me/?text=${encodeURIComponent(text + ' ' + url)}`,
      };

      window.open(shareUrls[platform], '_blank', 'width=600,height=400');
    });
  });

  // ── Friend prompt ─────────────────────────────────────
  function checkSharedResult() {
    const params = new URLSearchParams(window.location.search);
    const sharedResult = params.get('result');
    if (!sharedResult || !systemMap[sharedResult]) return;
    const sysName = systemMap[sharedResult].name;
    if (friendPrompt) {
      friendPrompt.textContent = `Your friend got ${sysName}. What will you get?`;
      friendPrompt.style.display = '';
    }
  }

  // ── Init ──────────────────────────────────────────────
  const restored = loadState();
  if (restored && primaryResult && secondaryResult) {
    showResult(primaryResult, secondaryResult);
  } else if (restored && currentQ > 0) {
    restoreMultiSelectVisuals();
    showQuestion(currentQ);
  } else {
    showQuestion(0);
  }
  checkSharedResult();
</script>
